# Copie para .env.local e preencha com as chaves do SEU projeto Supabase.
# Project Settings > API / API Keys no painel do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exclusiva do servidor. Nunca use NEXT_PUBLIC_ neste nome.
# Settings > API Keys > Secret keys: use sb_secret_... (somente servidor).
# Necessária para criar/administrar acessos e provisionar o primeiro administrador.
SUPABASE_SERVICE_ROLE_KEY=
